# Port the engine listens on
PORT=4021

# Stellar testnet address (G...) that receives the 0.05 USDC.
# It needs a USDC trustline (see engine/README.md).
PAY_TO=

# x402 facilitator that verifies and settles payments.
# Coinbase's testnet facilitator needs no key and sponsors fees.
FACILITATOR_URL=https://www.x402.org/facilitator

# Price per migration, in dollars of USDC, and network
PRICE=$0.05
NETWORK=stellar:testnet

# Signature lifetime and hard job limit. JOB_TIMEOUT_MS must leave at least
# 300 s of MAX_TIMEOUT_SECONDS to settle in (see the shared README).
MAX_TIMEOUT_SECONDS=900
JOB_TIMEOUT_MS=600000

# Which job runs after payment: "hello" (payment only) for now.
JOB=hello
